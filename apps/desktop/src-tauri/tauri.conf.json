{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimi Code",
  "version": "0.1.0",
  "identifier": "com.moonshotai.kimi-code",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "start /B kimi web --host 127.0.0.1 --port 5494 --no-open && npm run dev -- --port 5173",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "deep-link": {
      "schemes": ["kimi"]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Kimi Code",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
